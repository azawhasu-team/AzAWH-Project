# FastAPI Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
CORS_ORIGINS=http://localhost:3000,http:/ /localhost:3001

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=300

# Google Cloud Configuration
GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account-key.json
GCS_BUCKET_NAME=awh-station-data
FIRESTORE_COLLECTION=station_readings

# Data Configuration
MAX_QUERY_LIMIT=10000
DEFAULT_PAGE_SIZE=100

# Admin panel — shared secret the dashboard's server-side admin API routes
# attach to admin writes (PATCH/POST /admin/stations/*). Must match the
# dashboard's ADMIN_API_KEY. Bucket backs station image uploads.
ADMIN_API_KEY=
FIREBASE_STORAGE_BUCKET=
 
# Logging (optional). LOG_FORMAT: json (default on Render) or text (default locally).
# LOG_LEVEL=INFO
# LOG_FORMAT=text

# Alert notifications — see guides/ALERTING.md. With no channel set, alerts are only logged.
# PUBLIC_BASE_URL=https://az-awh-monitoring-system.onrender.com
# ALERT_LINK_SECRET=
# ALERT_SLACK_WEBHOOK_URL=
# ALERT_SMTP_HOST=
# ALERT_SMTP_PORT=587
# ALERT_SMTP_USER=
# ALERT_SMTP_PASSWORD=
# ALERT_EMAIL_FROM=
# ALERT_EMAIL_TO=
# ALERT_STALE_MINUTES=120
# ALERT_REMINDER_HOURS=12
