DASHBOARD_USER=change_me
DASHBOARD_PASSWORD=change_me
# Random secret used to sign session cookies (separate from the login
# password so sessions can be revoked by rotating this without changing
# DASHBOARD_PASSWORD). Generate with: openssl rand -hex 32
SESSION_SECRET=change_me

# Admin panel (/admin/stations) — a second gate layered ON TOP of the site
# login above. Being logged into the site isn't enough on its own to reach
# it; this passphrase is also required.
ADMIN_PASSPHRASE=change_me
# Generate with: openssl rand -hex 32
ADMIN_SESSION_SECRET=change_me
# Server-only (no NEXT_PUBLIC_ prefix) — must match the backend's
# ADMIN_API_KEY. Never exposed to the browser.
ADMIN_API_KEY=change_me

# Backend API. The backend is private: browser requests go through this app's
# /api/backend proxy, which attaches BACKEND_API_KEY server-side. Both are
# server-only (no NEXT_PUBLIC_ prefix) and never reach the browser.
# BACKEND_API_KEY must equal the backend's API_KEY.
BACKEND_URL=https://your-backend.onrender.com
BACKEND_API_KEY=change-me-openssl-rand-hex-32

# Optional but recommended on Vercel: a shared counter for login throttling (free
# Upstash Redis database > REST API tab). Without it, throttling is per instance only.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
